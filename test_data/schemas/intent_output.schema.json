{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent-only output",
  "type": "object",
  "additionalProperties": false,
  "required": ["test_case_id", "intent"],
  "properties": {
    "test_case_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "turn_index": {"type": "integer", "minimum": 1},
    "intent": {
      "type": "string",
      "enum": [
        "performance_analysis", "promotion_analysis", "pricing_analysis",
        "distribution_analysis", "assortment_analysis", "comparison",
        "trend_analysis", "forecast", "recommendation", "unsupported"
      ]
    }
  }
}
